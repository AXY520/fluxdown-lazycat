# apps/ipadown/app.env — ipaDown → 懒猫商店自动发布配置（由 scripts/sync.sh source）
# 触发源是内置 ipatool 的上游仓库：它出新版 → 升级 Dockerfile 内嵌版本 → 发新版 ipaDown
UPSTREAM_REPO=majd/ipatool
# 懒猫应用包 id（package.yml 的 package 字段）
PKG_ID=cloud.lazycat.app.ipadown
# 无 IMAGE_REPO：ipatool 不走上游 docker 镜像，而是 Dockerfile 构建时内嵌下载；
# 版本/校验和的跟随更新由 pre-build.sh 负责（应用自身版本号 patch+1，不用上游版本号）
IMAGE_REPO=

# 无 MARKER_*：ipatool 的 release notes 直接作为英文更新日志；
# pre-build.sh 会改写为「升级内置 ipatool」导向的中英文案
