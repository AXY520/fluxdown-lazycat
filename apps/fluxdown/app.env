# apps/fluxdown/app.env — FluxDown → 懒猫商店发布配置（由 scripts/sync.sh source）
# 上游 GitHub 仓库（owner/repo，读 releases/latest）
UPSTREAM_REPO=zerx-lab/FluxDown
# 懒猫应用包 id（package.yml 的 package 字段）
PKG_ID=cloud.lazycat.app.fluxdown
# 上游 Docker 镜像（lpk 全内嵌其 linux/amd64 层；留空 = 跳过拉取/FROM 改写/冒烟）
IMAGE_REPO=ghcr.io/zerx-lab/fluxdown-server

# ── 上游 release notes 解析约定（FluxDown release workflow 生成，见 plan.py）──
# 首行标记含 components= 列表；不含 GATE_COMPONENT 或 docker≠ok → 只记状态不发布
MARKER_BEGIN=fluxdown:release:begin
GATE_COMPONENT=server
# 双语更新日志分段标记
LANG_MARKER_ZH='<!-- fluxdown:lang:zh -->'
LANG_MARKER_EN='<!-- fluxdown:lang:en -->'
